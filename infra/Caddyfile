:80 {
  encode zstd gzip

  handle /api/* {
    reverse_proxy api:8000 {
      flush_interval -1
    }
  }

  handle /media/* {
    reverse_proxy api:8000
  }

  handle {
    root * /srv/frontend
    try_files {path} /index.html
    file_server
  }

  header {
    X-Content-Type-Options nosniff
    Referrer-Policy same-origin
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; font-src 'self'; object-src 'none'; frame-ancestors 'none'"
  }
}
